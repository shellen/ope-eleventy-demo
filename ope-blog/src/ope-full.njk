---
layout: base.njk
pagination:
  data: collections.opeGated
  size: 1
  alias: post
permalink: "_ope/full{{ post.url }}index.html"
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "{{ post.data.title }}"
---
{#- ABOUTME: Full versions of gated posts. The server sends these only after a License Token passes the spec §11.2 checks. -#}
<article>
  <h2>{{ post.data.title }}</h2>
  <div class="meta">
    {{ post.date.toISOString().slice(0,10) }}
    {% if post.data.ope_resource_type and post.data.ope_resource_type != "article" %} <span class="tag">{{ post.data.ope_resource_type }}</span>{% endif %}
    <span class="tag gated">Unlocked with OPE</span>
  </div>
  <div class="content">{{ post.content | safe }}</div>
</article>
