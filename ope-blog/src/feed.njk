---
permalink: feed.json
eleventyExcludeFromCollections: true
---
{#- ABOUTME: JSON Feed 1.1 with OPE v0.2 extensions (Feeds profile): Offers once at feed level, gated items marked. -#}
{%- set scope = ope.scopes[0] -%}
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ ope.publisherName | dump | safe }},
  "home_page_url": "{{ ope.siteUrl }}/",
  "feed_url": "{{ ope.siteUrl }}/feed.json",
  "_ope": {
    "about": "https://feedspec.org/ope/ns/0.2",
    "resource": "{{ scope.scope }}",
    "offers": {{ scope.offers | opeJson | safe }}
  },
  "items": [
    {%- for post in collections.post | reverse %}
    {
      "id": "{{ post.url | opeAbsolute }}",
      "url": "{{ post.url | opeAbsolute }}",
      "title": {{ post.data.title | dump | safe }},
      {%- if post.data.ope_gated %}
      "summary": {{ post.content | opePreview(280) | dump | safe }},
      "content_text": {{ post.content | opePreview(280) | dump | safe }},
      "_ope": {
        "resource": "{{ post.url | opeAbsolute }}"
        {%- if post.data.ope_offers %},
        "metadata": "{{ ope.siteUrl }}/.well-known/oauth-protected-resource{{ post.url }}",
        "offers": {{ post | opeItemOffers | opeJson | safe }}
        {%- endif %}
      },
      {%- else %}
      "content_html": {{ post.content | dump | safe }},
      {%- endif %}
      "date_published": "{{ post.date.toISOString() }}"
    }{{ "," if not loop.last }}
    {%- endfor %}
  ]
}
