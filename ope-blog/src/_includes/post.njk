---
layout: base.njk
---
{#- ope_unlocked: the plugin is rendering the full version of a gated post (ope_post). -#}
{%- set post_date = ope_post.date if ope_unlocked else page.date -%}
{%- set post_data = ope_post.data if ope_unlocked else null -%}
{%- set resource_type = post_data.ope_resource_type if ope_unlocked else ope_resource_type -%}
<article>
  <h2>{{ title }}</h2>
  <div class="meta">
    {{ post_date.toISOString().slice(0,10) }}
    {% if resource_type and resource_type != "article" %} <span class="tag">{{ resource_type }}</span>{% endif %}
    {% if ope_unlocked %} <span class="tag gated">Unlocked with OPE</span>{% elif ope_gated %} <span class="tag gated">Subscribers only</span>{% endif %}
  </div>

  {% if ope_gated and not ope_unlocked %}
    <div class="content">
      <p>{{ content | opePreview(400) }}</p>
    </div>
    <div class="gated-notice">
      <div class="stats">{{ content | opeWordCount }} words · {{ content | opeReadTime }} min read</div>
      <p style="margin-bottom: 0.75rem">{{ ope_cta | default("Subscribe to read the full post") }}</p>
      <p id="unlock-message" style="margin-bottom: 0.75rem; font-size: 0.85rem; color: var(--muted)" hidden></p>
      <a href="/_ope/unlock?post={{ page.url | urlencode }}" class="cta">Subscribe and read here</a>
      <p style="margin-top: 0.85rem; font-size: 0.85rem">Already a subscriber? The same button signs you in. Or read it in any OPE app, like the <a href="/reader/?post={{ page.url | opeAbsolute | urlencode }}">demo reader</a>.</p>
    </div>
    <script>
      // After a sign-in that didn't unlock the post, say why.
      (function () {
        var why = new URLSearchParams(location.search).get("unlock");
        if (!why) return;
        var text = { access_denied: "You declined, so the post wasn't unlocked.", no_entitlement: "You don't have a subscription that covers this post yet." }[why] || "The post couldn't be unlocked (" + why + "). Try again.";
        var el = document.getElementById("unlock-message"); el.textContent = text; el.hidden = false;
      })();
    </script>
  {% else %}
    <div class="content{% if ope_unlocked %} ope-paywalled{% endif %}">{{ content | safe }}</div>
    {% if ope_unlocked %}
    <p class="unlocked-note">You're reading with your subscription. <a href="/_ope/leave?post={{ ope_post.url | urlencode }}">Stop reading on this browser</a></p>
    {% endif %}
  {% endif %}
</article>
