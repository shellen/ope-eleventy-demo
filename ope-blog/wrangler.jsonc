// The OPE demo blog on Cloudflare Workers: the Eleventy build as static assets, and a
// Worker in front that sends gated posts through the OPE checks.
// Build variables: OPE_SITE_URL (this Worker's address) and OPE_LICENSE_SERVER.
// Optional secret: OPE_RS_CLIENT_SECRET, the License Server's introspection credential.
{
  "name": "ope-demo",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  // global_fetch_strictly_public: fetch() goes out through Cloudflare's public front door,
  // as from anywhere on the Internet. Without it, a Worker can't fetch another Worker on the
  // same workers.dev subdomain (error 1042), and the publisher and License Server call each
  // other over plain HTTP (metadata, keys, introspection).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Always serve at <name>.<subdomain>.workers.dev, whoever deploys; no per-version preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "rm -rf _site && npx @11ty/eleventy" },
  "assets": { "directory": "_site", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true }
}
