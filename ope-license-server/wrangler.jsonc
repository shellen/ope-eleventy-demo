// The OPE License Server on Cloudflare Workers.
// In the Worker's settings, set OPE_PROTECTED_RESOURCES (the publisher's scope) as a
// variable and OPE_RS_CLIENT_SECRET as a secret. The signing key is generated and kept
// by the Durable Object, and the issuer is the Worker's own address.
{
  "name": "ope-license-server",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "LICENSE_SERVER", "class_name": "LicenseServerState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LicenseServerState"] }],
  "observability": { "enabled": true },
  // Keep variables set in the dashboard when a deploy from Git runs.
  "keep_vars": true
}
