// The OPE License Server on Cloudflare Workers.
// In the Worker's settings, set OPE_PROTECTED_RESOURCES (the publisher's scope) as a
// variable and OPE_RS_CLIENT_SECRET as a secret. The signing key is generated and kept
// by the Durable Object, and the issuer is the Worker's own address.
{
  "name": "ope-license-server",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  // global_fetch_strictly_public: fetch() goes out through Cloudflare's public front door,
  // as from anywhere on the Internet. Without it, a Worker can't fetch another Worker on the
  // same workers.dev subdomain (error 1042), and the publisher and License Server call each
  // other over plain HTTP (metadata, keys, introspection).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Always serve at <name>.<subdomain>.workers.dev, whoever deploys; no per-version preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "LICENSE_SERVER", "class_name": "LicenseServerState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LicenseServerState"] }],
  "observability": { "enabled": true },
  // Keep variables set in the dashboard when a deploy from Git runs.
  "keep_vars": true
}
