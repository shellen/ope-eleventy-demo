{
  "name": "ope-license-server",
  "version": "0.2.0",
  "description": "Readable OPE v0.2 License Server: an OAuth 2.0 authorization server issuing DPoP-bound license+jwt tokens",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js && OPE_LS_ENTRY=test/netlify-shim.mjs node --test test/flow.test.js",
    "generate-key": "node scripts/generate-key.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.8",
    "express": "^4.21.0",
    "jose": "^6.2.15",
    "serverless-http": "^4.0.0"
  }
}
